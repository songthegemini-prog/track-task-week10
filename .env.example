# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Supabase
# Supabase → Project Settings → API Keys (และ Data API สำหรับ Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# งานเสริม US-6 (อีเมลแจ้งผู้รับงาน): ใส่เมื่อทำ US-6 เท่านั้น
# ใช้ Gmail ที่สมัครไว้ทดลองเท่านั้น · App Password สร้างที่ myaccount.google.com/apppasswords
# รหัสลับ ใช้ฝั่ง server เท่านั้น ห้ามเติม NEXT_PUBLIC_ ข้างหน้า
# GMAIL_USER=your-test-account@gmail.com
# GMAIL_APP_PASSWORD=your16letterapppassword
